# Backup cron configuration
# Copy to .env and adjust before running docker compose up

# زمان‌بندی cron (پیش‌فرض: هر روز ساعت 2 بامداد)
BACKUP_SCHEDULE=0 2 * * *

# آپلود به RustFS — true برای فعال‌سازی
RUSTFS_ENABLED=false

# آدرس RustFS (اگر RUSTFS_ENABLED=true)
RUSTFS_ENDPOINT=http://nexus_rustfs:9000

# نام bucket در RustFS
RUSTFS_BUCKET=nexus-backups

# نگهداری backup محلی (روز)
BACKUP_RETENTION_DAYS=30
